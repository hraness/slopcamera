# Hraness credits service the gateway holds and settles against (https origin).
SLOPCAMERA_CREDITS_SERVICE_ORIGIN=https://credits.hraness.com
# Product key issued by the credits service for the `slopcamera` product (cr_prod_…).
SLOPCAMERA_CREDITS_PRODUCT_KEY=
# The operator's Vercel AI Gateway key that pays the provider for hosted generations.
AI_GATEWAY_API_KEY=

{
  "$schema": "https://raw.githubusercontent.com/hraness/slopcamera/main/schema/diagram.schema.json",
  "version": 1,
  "name": "production-pipeline",
  "canvas": {
    "width": 1200,
    "height": 520,
    "padding": 64
  },
  "shapes": [
    {
      "id": "author",
      "type": "rect",
      "x": 64,
      "y": 64,
      "width": 272,
      "height": 136,
      "radius": 24,
      "label": "Author",
      "labelFontSize": 48,
      "labelWeight": 400,
      "tone": "neutral"
    },
    {
      "id": "check",
      "type": "rect",
      "x": 464,
      "y": 64,
      "width": 272,
      "height": 136,
      "radius": 24,
      "label": "Check",
      "labelFontSize": 48,
      "labelWeight": 400,
      "tone": "neutral"
    },
    {
      "id": "render",
      "type": "rect",
      "x": 864,
      "y": 64,
      "width": 272,
      "height": 136,
      "radius": 24,
      "label": "Render",
      "labelFontSize": 48,
      "labelWeight": 400,
      "tone": "neutral"
    },
    {
      "id": "review",
      "type": "rect",
      "x": 864,
      "y": 320,
      "width": 272,
      "height": 136,
      "radius": 24,
      "label": "Review",
      "labelFontSize": 48,
      "labelWeight": 400,
      "tone": "neutral"
    },
    {
      "id": "deliver",
      "type": "rect",
      "x": 464,
      "y": 320,
      "width": 272,
      "height": 136,
      "radius": 24,
      "label": "Deliver",
      "labelFontSize": 48,
      "labelWeight": 400,
      "tone": "green"
    }
  ],
  "edges": [
    {
      "id": "author-check",
      "from": "author",
      "to": "check",
      "start": "right",
      "end": "left"
    },
    {
      "id": "check-render",
      "from": "check",
      "to": "render",
      "start": "right",
      "end": "left"
    },
    {
      "id": "render-review",
      "from": "render",
      "to": "review",
      "start": "bottom",
      "end": "top"
    },
    {
      "id": "review-deliver",
      "from": "review",
      "to": "deliver",
      "start": "left",
      "end": "right"
    }
  ]
}

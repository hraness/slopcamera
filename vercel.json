{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bun scripts/api-deploy-selection.ts",
  "buildCommand": "echo 'slopcamera-api: functions only'",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/$1" }
  ]
}

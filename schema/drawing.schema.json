{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hraness/slopcamera/main/schema/drawing.schema.json",
  "title": "Slopcamera drawing sheets, version 1",
  "description": "Editable physical drawing sheets containing existing version-one diagrams. Runtime profile checks additionally require monochrome uppercase labels, measured glyph heights, physical ink bounds, and consecutive figure numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "paper", "sheets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "paper": { "enum": ["us-letter", "a4"] },
    "sheets": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["figure", "diagram"],
        "properties": {
          "figure": { "type": "integer", "minimum": 1, "maximum": 20 },
          "diagram": { "$ref": "https://raw.githubusercontent.com/hraness/slopcamera/main/schema/diagram.schema.json" }
        }
      }
    }
  }
}
